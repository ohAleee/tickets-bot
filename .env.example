# ---- Discord ----
DISCORD_BOT_TOKEN=
DISCORD_BOT_CLIENT_ID=
DISCORD_BOT_OAUTH_SECRET=
DISCORD_BOT_PUBLIC_KEY=
DISCORD_SUPPORT_SERVER_INVITE=https://discord.gg/ticketsbot

# ---- Access control ----
ADMIN_USER_IDS=
HELPER_USER_IDS=

# ---- Single Postgres instance (hosts ticketsbot + botcache + archive) ----
DATABASE_PASSWORD=changeme

# ---- Redis ----
# Left empty: Redis runs with no password and clients send no AUTH. To enable a password,
# see the note on the redis service in docker-compose.yml.
REDIS_PASSWORD=

# ---- Dashboard ----
DASHBOARD_URL=http://localhost:5000
API_URL=http://localhost:8082
LANDING_PAGE_URL=https://tickets.bot
DOCS_URL=https://docs.tickets.bot
REDIRECT_WEBSITE=https://tickets.bot
INVITE_URL=https://discord.com
JWT_SECRET=changeme-long-random-string
REAL_IP_HEADERS=X-Forwarded-For
TRUSTED_PROXIES=127.0.0.1,172.21.0.1
# http-gateway is the interaction ingress; point Discord's interactions endpoint at it.
# MUST be a PUBLIC HTTPS url reaching http-gateway (host port 8088): the dashboard registers
# {INTERACTIONS_BASE_URL}/handle/{bot_id} on the Discord application, and Discord validates it
# immediately — an internal http:// hostname is rejected. Example: https://tickets.example.com/gateway
INTERACTIONS_BASE_URL=http://http-gateway:4000

# Whitelabel bots serve their guilds instead of the public bot. Set to true once the public bot is
# no longer in any server: a guild with no whitelabel bot assigned then fails with a clear error
# rather than silently falling back to the public bot (which would 403 from Discord).
WHITELABEL_ONLY=false

# ---- Branding (optional) ----
POWERED_BY=github.com/ticketsbot-cloud
ICON_URL=https://tickets.bot/assets/img/logo.png

# ---- Custom (application) emojis (optional) ----
# Discord application emojis can ONLY be used by the app that owns them, so a
# self-hosted bot cannot render the upstream Tickets emojis. Upload your own in
# the Discord Developer Portal (your app > Emojis) and paste their IDs below.
# Leave a value blank to render that slot without an emoji. Names shown in the
# close embed: id, open, opentime, close, reason, claim.
# These apply to the PUBLIC bot only. Whitelabel bots own a different application,
# so they configure their own emojis on the dashboard's Whitelabel page.
EMOJI_ID=
EMOJI_OPEN=
EMOJI_OPENTIME=
EMOJI_CLOSE=
EMOJI_CLOSETIME=
EMOJI_REASON=
EMOJI_SUBJECT=
EMOJI_TRANSCRIPT=
EMOJI_CLAIM=
EMOJI_PANEL=
EMOJI_RATING=
EMOJI_STAFF=
EMOJI_THREAD=
EMOJI_BULLETLINE=
EMOJI_PATREON=
EMOJI_DISCORD=
EMOJI_LOGO=

# ---- Fresh database ----
# Set to true for a brand-new database to auto-create the schema on startup
# (idempotent; leave empty once the schema exists). See docs/SETUP.md.
INIT_SCHEMA=

# ---- Autoclose sweep (minutes) ----
SWEEP_TIME=10

# ---- Transcripts / archiver ----
ARCHIVER_AES_KEY=
ARCHIVER_ADMIN_AUTH_TOKEN=
# UUID of the default transcript bucket (seeded active by INIT_SCHEMA). Keep stable.
DEFAULT_BUCKET_ID=b77cc1a0-91ec-4d64-bb6d-21717737ea3c

# ---- S3 (rustfs) ----
S3_ENDPOINT=http://rustfs:9000
S3_ACCESS=
S3_SECRET=
S3_SECURE=false
S3_ARCHIVE_BUCKET=archive
S3_DATA_IMPORT_BUCKET=data-import
S3_TRANSCRIPT_IMPORT_BUCKET=transcript-import

# ---- Observability (optional) ----
SENTRY_DSN=

# ---- Host user mapping for bind-mounted volumes (optional) ----
UID=
GID=
